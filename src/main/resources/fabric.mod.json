{
  "schemaVersion": 1,
  "id": "mmorpg",
  "version": "${version}",
  "name": "Age of Epoch (Mine and Slash Rework Suite)",
  "description": "Unified Minecraft 26.3 port of the full 6-mod Mine and Slash ARPG suite (Library of Exile, Orbs of Crafting, Mine and Slash, Dungeon Realm, Ancient Obelisks, The Harvest) integrated with custom Age of Epoch endgame systems.",
  "authors": [
    "mcrobertx22 (Robert Skalko)",
    "Antoniumu (Age of Epoch 26.3 port)"
  ],
  "contact": {
    "sources": "https://github.com/Antoniumu/Age-of-Epoch"
  },
  "license": "MIT",
  "icon": "assets/mmorpg/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.robertx22.age_of_exile.mmorpg.AgeOfEpochMod"
    ],
    "client": [
      "com.robertx22.age_of_exile.mmorpg.AgeOfEpochClientMod"
    ]
  },
  "mixins": [
    "age_of_epoch-mixins.json",
    "library_of_exile-mixins.json",
    "mmorpg-mixins.json"
  ],
  "provides": [
    "library_of_exile",
    "orbs_of_crafting",
    "dungeon_realm",
    "ancient_obelisks",
    "the_harvest",
    "age_of_exile"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.163.0",
    "minecraft": "~26.3",
    "java": ">=25",
    "trinkets_updated": ">=4.2.1"
  }
}
